/*
Mindustry mod metadata.

"main" points at the mod's entry-point class. Mindustry loads this class via
reflection and instantiates it once, at which point its constructor runs
(see UnlimitedUnitCapMod.java).
*/
{
  name: "unlimited-unit-cap"
  displayName: "Unlimited Unit Cap"
  author: "YourName"
  description: "Adds a toggle, accessible from the pause menu, that lets you disable the unit cap on a per-map basis. Your choice is remembered separately for every map and restored automatically the next time you play it."
  version: "1.0"
  main: "unlimitedunitcap.UnlimitedUnitCapMod"

  // This is a pure-Java mod (no custom content/scripts), so it must be compiled to a jar.
  java: true

  // Rules#disableUnitCap (the field this mod flips) isn't present in older Mindustry
  // releases - it was added after v146. Set to a version you've confirmed has it; the
  // bundled build.gradle compiles against v159.5.
  minGameVersion: "159"

  hidden: false
}
